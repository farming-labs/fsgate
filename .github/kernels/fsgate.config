# Kernel options the fsgate tests need, appended to virtme-ng's minimal
# config (`vng --kconfig`) before `make olddefconfig`. The workflow checks
# that each line survives into the final .config.
#
# Landlock is the only LSM: the second boot drops it with `lsm=capability`.
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# Debug info only slows the build.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
